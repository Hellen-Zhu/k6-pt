# Copy to ~/.config/k6pt-portal.env and fill the real values (server-local, never in git).
# PATH must include the k6 shim dir; K6_IMAGE pins the container the shim runs.
PATH=/home/<user>/bin:/usr/local/bin:/usr/bin:/bin
K6_IMAGE=<internal-registry>/grafana/k6:<pinned-tag>
K6_INSECURE_SKIP_TLS_VERIFY=true
PORTAL_ADDR=127.0.0.1
PORTAL_PORT=8090
# PORTAL_TOKEN=<set when exposing beyond localhost>
# PERF_HOME=<override if the checkout is not %h/perf>
